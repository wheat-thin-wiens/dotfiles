{
  "position": "top",
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "spacing": 5,
  "reload_style_on_change": true,
  "modules-left": [
    "group/power",
    "hyprland/workspaces",
    "hyprland/window"
    // "window-title"
  ],
  "modules-center": [
    "clock#time"
  ],
  "modules-right": [
    // "cava",
    "pulseaudio",
    "backlight",
    "bluetooth",
    "network",
    "clock#date"
  ],
  "hyprland/window": {
    "format": "{title}",
    // "format": "{icon}",
    // "format-field": {
    //   "title": "{title}",
    //   "icon": "{title}",
    // },
    // "format-icons": {
    //   "": " "
    // },
    "max-length": 50,
    "separate-outputs": true
  },
  "window-title": {
    "format": "{}",
    "max-length": 60,
    "exec": "hyprcl clients -j | jq -r '.[] | select(.focused=true) | .title' 2>/dev/null || echo''",
    "interval": 0.5,
    "return-type": "text"
  },
  "clock#time": {
    "format": "<span></span>{:%I:%M}",
    "tooltip": false,
  },
  "clock#date": {
    "format": "<span></span>{:%a %d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "format-wifi": "<span size='13000'>{icon}</span>",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "<span size='13000'>󰈁</span> Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span size='13000'>󰤭  </span>Disconnected",
    "tooltip-format-wifi": "Network: {essid}\nSignal Strenght: {signalStrength}%",
    "on-click": "nmcli device wifi list"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", ""]
    },
    "scroll-step": 5,
    "tooltip-format": "{desc} - {volume}%",
    "on-click": "pavucontrol"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    // "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": ""
    },
    "sort-by-number": true
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected-battery": "󰥈 {device_alias} {device_battery_percentage}%",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "on-click": "blueman-manager"
  },
  // "cava": {
  //   // "cava_config": "$XDG_CONFIG_HOME/cava/config",
  //   "framerate": 30,
  //   "autosens": 1,
  //   // "sensitivity": 5,
  //   "bars": 8,
  //   "lower_cutoff_freq": 50,
  //   "higher_cutoff_freq": 10000,
  //   "method": "pulse",
  //   "source": "auto",
  //   "stereo": true,
  //   "reverse": false,
  //   "bar_delimiter": 0,
  //   "monstercat": false,
  //   "noise_reduction": 0.77,
  //   "input_delay": 2,
  //   "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
  //   "actions": {}
  // },
  "custom/power_button": {
    "format": "⏻",
    "on-click": "shutdown now",
    "tooltip-format": "Shutdown"
  },
  "custom/restart": {
    "format": "  ",
    "on-click": "shutdown -r now",
    "tooltip-format": "Restart"
  },
  "custom/logout": {
    "format": " 󰍃 ",
    "on-click": "hyprctl dispatch exit",
    "tooltip-format": "Log out"
  },
  "custom/lock": {
    "format": "  ",
    "on-click": "hyprctl dispatch exit",
    "tooltip-format": "Lock screen"
  },
  "custom/os_button": {
    // "format": "",
    "format": "󰣇",
    "on-click": "",
    "tooltip-format": "arch btw"
  },
  "custom/wlsunset": {
    "format": "󱍖",
    "on-click": "bash ~/.config/waybar/scripts/wlsunset.sh",
    "tooltip-format": "Toggle wlsunset"
  },
  "custom/caffeine": {
    "format": "",
    "on-click": "bash caffeine &",
    "tooltip-format": "Toggle caffeine"
  },
  "custom/settings": {
    "format": "  "
  },
  "group/sound": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 250,
      "transition-left-to-right": false
    },
    "modules": ["pulseaudio", "cava"]
  },
  "group/networking": {
    "orientation": "horizontal",
    "modules": []
  },
  "group/power": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 250,
      "transition-left-to-right": true
    },
    "modules": ["custom/os_button", "custom/power_button", "custom/restart", "custom/lock", "custom/logout"]
  },
  "group/settings": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 250,
      "transition-left-to-right": false
    },
    "modules": ["custom/settings", "bluetooth", "custom/wlsunset", "custom/caffeine"]
  },
  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {},
    "modules": []
  }
}
